# GenomeAI Docker Environment Configuration

# Database Connection (Supabase PostgreSQL or local PostgreSQL)
# If using SQLite (default fallback), leave this commented out or blank.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Security Keys
GENOMEAI_SECRET_KEY=your_super_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Allowed Origins (CORS) - Comma separated list
ALLOWED_ORIGINS=*,http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173

# Frontend Clarity Project ID (Optional)
VITE_CLARITY_PROJECT_ID=YOUR_PROJECT_ID
